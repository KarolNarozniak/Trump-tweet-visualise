# Global config lookup
TG_CONFIG_PATH=config/defaults.toml

# Build defaults
TG_BUILD_INPUT_CSV=tweets_01-08-2021.csv
TG_BUILD_OUTPUT_DIR=data/processed
TG_BUILD_MIN_MENTION_COUNT=1
TG_BUILD_GLOBAL_MIN_MENTIONS=8
TG_BUILD_INCLUDE_RETWEETS=true
TG_BUILD_HEAT_DECAY=0.85
TG_BUILD_LAYOUT_SEED=42

# Truth Social semantic build defaults
TG_TRUTH_BUILD_INPUT_PATH=truthsocial.posts[Trump-FROM-10-8-25].txt
TG_TRUTH_BUILD_OUTPUT_DIR=data/processed_truth
TG_TRUTH_BUILD_SEMANTIC_BACKEND=hf
TG_TRUTH_BUILD_TOPIC_MODEL_ID=facebook/bart-large-mnli
TG_TRUTH_BUILD_NER_MODEL_ID=dslim/bert-base-NER
TG_TRUTH_BUILD_SENTIMENT_MODEL_ID=cardiffnlp/twitter-roberta-base-sentiment-latest
TG_TRUTH_BUILD_EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
TG_TRUTH_BUILD_DEVICE=auto
TG_TRUTH_BUILD_BATCH_SIZE=16
TG_TRUTH_BUILD_TOPIC_THRESHOLD=0.35
TG_TRUTH_BUILD_MAX_TOPIC_LABELS=3
TG_TRUTH_BUILD_ENTITY_SCORE_THRESHOLD=0.65
TG_TRUTH_BUILD_MAX_CHUNK_CHARS=900
TG_TRUTH_BUILD_MIN_NODE_COUNT=8
TG_TRUTH_BUILD_INCLUDED_NODE_TYPES=topic,per,org,loc,hashtag,mention
TG_TRUTH_BUILD_HEAT_DECAY=0.85
TG_TRUTH_BUILD_LAYOUT_SEED=99

# Unified Twitter + Truth semantic build defaults
TG_UNIFIED_BUILD_TWITTER_INPUT_CSV=tweets_01-08-2021.csv
TG_UNIFIED_BUILD_TRUTH_INPUT_PATH=truthsocial.posts[Trump-FROM-10-8-25].txt
TG_UNIFIED_BUILD_OUTPUT_DIR=data/processed_unified
TG_UNIFIED_BUILD_INCLUDE_RETWEETS=true
TG_UNIFIED_BUILD_SEMANTIC_BACKEND=hf
TG_UNIFIED_BUILD_TOPIC_MODEL_ID=facebook/bart-large-mnli
TG_UNIFIED_BUILD_NER_MODEL_ID=dslim/bert-base-NER
TG_UNIFIED_BUILD_SENTIMENT_MODEL_ID=cardiffnlp/twitter-roberta-base-sentiment-latest
TG_UNIFIED_BUILD_EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
TG_UNIFIED_BUILD_DEVICE=auto
TG_UNIFIED_BUILD_BATCH_SIZE=16
TG_UNIFIED_BUILD_TOPIC_THRESHOLD=0.35
TG_UNIFIED_BUILD_MAX_TOPIC_LABELS=3
TG_UNIFIED_BUILD_ENTITY_SCORE_THRESHOLD=0.65
TG_UNIFIED_BUILD_MAX_CHUNK_CHARS=900
TG_UNIFIED_BUILD_MIN_NODE_COUNT=8
TG_UNIFIED_BUILD_INCLUDED_NODE_TYPES=topic,per,org,loc,hashtag,mention
TG_UNIFIED_BUILD_HEAT_DECAY=0.85
TG_UNIFIED_BUILD_LAYOUT_SEED=211

# App defaults
TG_APP_PROCESSED_DIR=data/processed
TG_APP_INCLUDE_HUB=true
TG_APP_ALWAYS_LABEL_TOP_NODES=false
TG_APP_PLAYBACK_SPEED=8.0
TG_APP_NODE_SIZE_MULTIPLIER=2.0
TG_APP_LAYOUT_SPREAD=1.0
TG_APP_INITIAL_ZOOM_BOOST=0.8
TG_APP_GRAPH_HEIGHT_PX=1000

# Truth Social page defaults
TG_TRUTH_APP_PROCESSED_DIR=data/processed_truth
TG_TRUTH_APP_INCLUDE_RETRUTHS=true
TG_TRUTH_APP_NODE_TYPES=topic,per,org,loc
TG_TRUTH_APP_SENTIMENT_FILTER=all
TG_TRUTH_APP_MIN_NODE_COUNT=8
TG_TRUTH_APP_PLAYBACK_SPEED=6.0
TG_TRUTH_APP_NODE_SIZE_MULTIPLIER=1.8
TG_TRUTH_APP_LAYOUT_SPREAD=1.15
TG_TRUTH_APP_INITIAL_ZOOM_BOOST=0.85
TG_TRUTH_APP_GRAPH_HEIGHT_PX=920

# Semantic page defaults (unified labels graph)
TG_SEMANTIC_APP_PROCESSED_DIR=data/processed_unified
TG_SEMANTIC_APP_INCLUDE_REPOSTS=true
TG_SEMANTIC_APP_NODE_TYPES=topic,per,org,loc
TG_SEMANTIC_APP_SENTIMENT_FILTER=all
TG_SEMANTIC_APP_MIN_NODE_COUNT=8
TG_SEMANTIC_APP_PLAYBACK_SPEED=6.0
TG_SEMANTIC_APP_NODE_SIZE_MULTIPLIER=1.8
TG_SEMANTIC_APP_LAYOUT_SPREAD=1.15
TG_SEMANTIC_APP_INITIAL_ZOOM_BOOST=0.9
TG_SEMANTIC_APP_GRAPH_HEIGHT_PX=920

# Forecast page defaults (Temporal NN / baseline preview)
TG_FORECAST_APP_SEMANTIC_PROCESSED_DIR=data/processed_unified
TG_FORECAST_APP_PROCESSED_DIR=data/processed_forecast
TG_FORECAST_APP_DEFAULT_MODE=baseline
TG_FORECAST_APP_HORIZON_WEEKS=16
TG_FORECAST_APP_LOOKBACK_WEEKS=12
TG_FORECAST_APP_COMPARISON_LOOKBACK_WEEKS=52
TG_FORECAST_APP_NODE_TYPES=topic,per,org,loc
TG_FORECAST_APP_MIN_NODE_COUNT=8
TG_FORECAST_APP_PLAYBACK_SPEED=6.0
TG_FORECAST_APP_NODE_SIZE_MULTIPLIER=1.9
TG_FORECAST_APP_LAYOUT_SPREAD=1.15
TG_FORECAST_APP_INITIAL_ZOOM_BOOST=0.92
TG_FORECAST_APP_GRAPH_HEIGHT_PX=920

# Forecast training defaults (model artifact generation)
TG_FORECAST_TRAIN_INPUT_DIR=data/processed_unified
TG_FORECAST_TRAIN_OUTPUT_DIR=data/processed_forecast
TG_FORECAST_TRAIN_DEVICE=auto
TG_FORECAST_TRAIN_HORIZON_WEEKS=16
TG_FORECAST_TRAIN_LOOKBACK_WEEKS=12
TG_FORECAST_TRAIN_VALIDATION_WEEKS=12
TG_FORECAST_TRAIN_EPOCHS=30
TG_FORECAST_TRAIN_HIDDEN_DIM=32
TG_FORECAST_TRAIN_LEARNING_RATE=0.002
TG_FORECAST_TRAIN_WEIGHT_DECAY=0.00001
TG_FORECAST_TRAIN_SEED=42

# Runtime defaults
TG_RUNTIME_STREAMLIT_HOST=0.0.0.0
TG_RUNTIME_STREAMLIT_PORT=3001
TG_RUNTIME_DOCS_HOST=0.0.0.0
TG_RUNTIME_DOCS_PORT=3002
TG_RUNTIME_DOCS_URL=http://localhost:3002
TG_RUNTIME_DOCS_SITE_DIR=docs-site

# App metadata and legal copy
TG_META_APP_NAME=Trump Graph
TG_META_LOGO_PATH=logo.png
TG_META_DATA_SOURCE_URL=https://www.thetrumparchive.com/
TG_META_REPOSITORY_URL=https://github.com/KarolNarozniak/Trump-tweet-visualise
TG_META_DISCLAIMER_TEXT=Disclaimer: This visualization is a student educational project for studying time-dependent graph behavior. It is not intended as political endorsement, defamation, or factual/legal judgment about any person.
TG_META_ABOUT_TEXT=Trump Graph is a student project focused on temporal network analysis. Its purpose is to explore how mentions and co-mentions evolve over time in archived tweet data. The project is purely educational.
